# No trailing slash: a `node_modules` SYMLINK (used to run a worktree's tests
# against the main checkout's installs) is not a directory, so `node_modules/`
# would leave it untracked-but-stageable.
node_modules
dist/
# The single-executable image: the CJS bundle, the SEA blob and the injected
# binary per RID (./build.sh --sea). A release artifact, never source.
dist-sea/

# The desktop shell's Cargo workspace output (apps/desktop). Its dist/ is NOT
# a build product: it is the one-line starting page Tauri loads before the
# daemon's page replaces it, checked in.
apps/desktop/target/
!apps/desktop/dist/
*.tsbuildinfo
coverage/
.vitest/

# Java extractor (Maven)
extractors/java/target/

# C# extractor (.NET SDK): build output and the publish matrix
extractors/csharp/**/bin/
extractors/csharp/**/obj/
extractors/csharp/dist/

.DS_Store
.idea/
.vscode/
*.log

# Agent worktrees and local session state. `.remember/` is the session
# handoff a local hook writes: machine paths, tool caches, in-progress notes —
# never part of a public repository.
.claude/
.remember/

# The SQLite analysis store: a DERIVED, DISPOSABLE cache of a model.jsonl,
# built beside it on demand and regenerable at any time. Never committed —
# the .jsonl is the contract, and a binary next to it in git would be a
# second, undiffable answer to the same question.
*.db

books

# Elixir extractor (Mix): build output, fetched deps, the escript and the Burrito binaries
extractors/elixir/_build/
extractors/elixir/deps/
extractors/elixir/dist/
extractors/elixir/burrito_out/

# A BEAM crash dump is never a source file
erl_crash.dump

# The viz bundle `pnpm --filter @codegraph/website viz` copies beside the
# corpora cities; the JSONs are content, the bundle is a build product.
website/static/city/index.html
website/static/city/assets/

# Playwright screenshots taken while checking the website
/.playwright-mcp/
