# No trailing slash: a `node_modules` SYMLINK (used to run a worktree's tests
# against the main checkout's installs) is not a directory, so `node_modules/`
# would leave it untracked-but-stageable.
node_modules
dist/
*.tsbuildinfo
coverage/
.vitest/

# Java extractor (Maven)
extractors/java/target/

.DS_Store
.idea/
.vscode/
*.log

# Agent worktrees and local session state
.claude/

# The SQLite analysis store: a DERIVED, DISPOSABLE cache of a model.jsonl,
# built beside it on demand and regenerable at any time. Never committed —
# the .jsonl is the contract, and a binary next to it in git would be a
# second, undiffable answer to the same question.
*.db
