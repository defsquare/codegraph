{
  "name": "codegraph",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "codegraph": "./bin/codegraph"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "gen:schemas": "pnpm --filter @codegraph/core run gen:schemas",
    "ci": "pnpm -r build && pnpm -r typecheck && pnpm -r test"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.33.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4"
  }
}
