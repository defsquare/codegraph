#!/usr/bin/env bash
# The Python extractor as a program: `./bin/codegraph-python --src <dir> --out model.jsonl`.
#
# Extensionless on purpose — the name IS the command. It runs the release
# binary `build.sh --python` produces beside ITSELF (a git worktree or a moved
# checkout runs its own target/); the binary needs nothing installed — no Python.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
bin="$here/../extractors/python/target/release/codegraph-python"
[ -x "$bin" ] || bin="$bin.exe"

if [ ! -x "$bin" ]; then
  printf 'codegraph-python: extractors/python/target/release/codegraph-python is missing\n' >&2
  printf 'Run `./build.sh --python` in %s and try again.\n' "$(cd "$here/.." && pwd)" >&2
  exit 1
fi

exec "$bin" "$@"
