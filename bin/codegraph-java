#!/usr/bin/env bash
# The Java extractor as a program: `./bin/codegraph-java --src DIR --out model.jsonl`.
#
# Extensionless on purpose — the name IS the command. It runs the shaded jar
# `build.sh --java` produces beside ITSELF (a git worktree or a moved checkout
# runs its own target/), on the first Java at or above pom.xml's
# maven.compiler.release — a JRE will do, ECJ only needs its class library.
# Non-interactive shells never source sdkman, so its candidates are probed too.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
jar="$here/../extractors/java/target/codegraph-java.jar"

if [ ! -f "$jar" ]; then
  printf 'codegraph-java: extractors/java/target/codegraph-java.jar is missing\n' >&2
  printf 'Run `./build.sh --java` in %s and try again.\n' "$(cd "$here/.." && pwd)" >&2
  exit 1
fi

want="$(sed -n 's:.*<maven\.compiler\.release>\([0-9][0-9]*\)</maven\.compiler\.release>.*:\1:p' \
  "$here/../extractors/java/pom.xml" | head -1)"

# "1.8.0_392" -> 8, "17.0.2" -> 17, "21" -> 21 (a GA build prints no minor).
major() {
  "$1" -version 2>&1 | sed -n '1s/.*version "\([^"]*\)".*/\1/p' | awk -F'[.+_-]' '{ print ($1 == 1 ? $2 : $1) }'
}

# Search order is preference order: JAVA_HOME, PATH, sdkman's selected JDK,
# every sdkman candidate, then macOS's registry. The first one recent enough wins.
find_java() {
  local candidate have
  set -- "${JAVA_HOME:+$JAVA_HOME/bin/java}" "$(command -v java 2>/dev/null || true)" \
    "$HOME/.sdkman/candidates/java/current/bin/java" "$HOME"/.sdkman/candidates/java/*/bin/java
  if [ -x /usr/libexec/java_home ]; then
    set -- "$@" "$(/usr/libexec/java_home -v "$want+" 2>/dev/null || true)/bin/java"
  fi
  for candidate in "$@"; do
    [ -n "$candidate" ] && [ -x "$candidate" ] || continue
    have="$(major "$candidate")"
    if [ -n "$have" ] && [ "$have" -ge "$want" ] 2>/dev/null; then printf '%s' "$candidate"; return 0; fi
  done
  return 1
}

if ! java="$(find_java)"; then
  printf 'codegraph-java: no Java %s+ in JAVA_HOME, on PATH or under ~/.sdkman — the jar needs one\n' "$want" >&2
  printf 'sdkman: sdk install java 25.0.4-tem    homebrew: brew install --cask temurin\n' >&2
  exit 1
fi

exec "$java" -jar "$jar" "$@"
