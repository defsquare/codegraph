<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.codegraph</groupId>
  <artifactId>codegraph-java</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <name>codegraph-java</name>
  <description>
    Spoon-based Java extractor. Emits model.json conforming to schemas/model.schema.json.
    Contains no metamodel intelligence: the schema is the whole contract.
  </description>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spoon.version>11.5.0</spoon.version>
    <!-- Must match the ecj spoon-core resolves; bump both together. -->
    <ecj.version>3.46.0</ecj.version>
    <jackson.version>2.22.2</jackson.version>
    <junit.version>5.14.4</junit.version>
    <jsonschema.version>3.0.6</jsonschema.version>
    <exec.plugin.version>3.6.1</exec.plugin.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>fr.inria.gforge.spoon</groupId>
      <artifactId>spoon-core</artifactId>
      <version>${spoon.version}</version>
    </dependency>
    <!-- Spoon's compiler front end. Declared explicitly because CorpusLauncher
         reads JDT's own problem ids (IProblem.DuplicateTypes) rather than
         matching on an English message. -->
    <dependency>
      <groupId>org.eclipse.jdt</groupId>
      <artifactId>ecj</artifactId>
      <version>${ecj.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <!-- Spoon logs through SLF4J. Bind NOP so stderr carries only the
         extractor's own resolution summary, which is machine-read output. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-nop</artifactId>
      <version>2.0.18</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- The extractor's own tests validate its output against the published
         JSON Schema — the same contract a Go or .NET extractor would use. -->
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <version>${jsonschema.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>codegraph-java</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.6</version>
      </plugin>
      <!-- The platform reference library, distilled from the build JDK's ct.sym.
           ECJ resolves java.* against the JVM it runs inside; a GraalVM native
           image has no JVM, so the binary has to carry the API with it (the same
           call the C# extractor makes about the BCL reference pack, PLAN.md
           §13.1). maven.compiler.release is the single source of truth for which
           release: the corpus is parsed at that level, so it is resolved at that
           level too. Lands in target/classes, hence inside the shaded jar and
           inside the image. Emits TWO files: the jar ECJ resolves against, and a
           SECOND reachability-metadata.json naming java.base's types — Spoon
           resolves imports through the runtime classloader, which in an image
           answers only for what was compiled into it. It sits under its own
           artifact directory so the agent-traced metadata next to it stays a
           committed, hand-reviewable file. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>${exec.plugin.version}</version>
        <executions>
          <execution>
            <id>platform-reference-jar</id>
            <phase>process-classes</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>dev.codegraph.spoon.build.PlatformReferenceJar</mainClass>
              <classpathScope>compile</classpathScope>
              <arguments>
                <argument>${maven.compiler.release}</argument>
                <argument>${project.build.outputDirectory}/dev/codegraph/spoon/java-api.jar</argument>
                <argument>${project.build.outputDirectory}/META-INF/native-image/dev.codegraph/codegraph-java-platform/reachability-metadata.json</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>dev.codegraph.spoon.Main</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
