{
  "name": "@codegraph/insights",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Codegraph insights: the bottom-up walk of a model that feeds an LLM each unit's source and its dependencies' explanations, and the side-car artifact holding the explanations — pure computation, no network",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@codegraph/analyzer": "workspace:*",
    "@codegraph/core": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
