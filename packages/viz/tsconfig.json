{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // A Vite app, not a Node library: bundler resolution, DOM available.
    // The scene-model layer under src/scene must still not touch the DOM —
    // that separation is by review and tests, the lib flag cannot express it.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["src", "test", "vite.config.ts"]
}
