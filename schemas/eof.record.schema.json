          "type": "integer"
        },
        "entities": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "files": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "files",
        "entities",
        "edges"
      ],
      "type": "object"
    },
    "t": {
      "const": "eof",
      "type": "string"
    }
  },
  "required": [
    "t",
    "counts"
  ],
  "title": "Codegraph model.jsonl \"eof\" record (interchange contract 1.0.0)",
  "type": "object"
